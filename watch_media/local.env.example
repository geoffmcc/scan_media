# Local puller config. Copy to watch_media/local.env and edit for your workstation.

REMOTE_MEDIA_ROOT="/media/Media/Video"
LOCAL_MEDIA_MOUNT="/mnt/your-media-drive"
LOCAL_MEDIA_ROOT="/mnt/your-media-drive/Video"
REMOTE_SSH="scanmedia@your-jellyfin-lan-ip"
REMOTE_QUEUE="/var/lib/scan_media/changed-files.queue"
SCANNER="/path/to/scan_media/scan_transcode.sh"
REPORT_STEM="/path/to/output/media_report"
FORMAT="both"
JOBS="8"
